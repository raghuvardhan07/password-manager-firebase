rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    function isFamilyCreator(fid) {
      return get(/databases/$(database)/documents/families/$(fid)).data.createdBy == request.auth.uid;
    }

    // personal item: owner reads. shared item: family members read.
    function canRead(data) {
      return signedIn() && (
        (data.familyId == null && data.userId == request.auth.uid) ||
        (data.familyId != null && myFamilyId() == data.familyId)
      );
    }

    // personal item: owner writes. shared item: only the family creator writes.
    function canWrite(data) {
      return signedIn() && (
        (data.familyId == null && data.userId == request.auth.uid) ||
        (data.familyId != null && isFamilyCreator(data.familyId))
      );
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /passwords/{id} {
      allow read: if canRead(resource.data);
      allow create: if canWrite(request.resource.data)
                    && request.resource.data.userId == request.auth.uid;
      allow update: if canWrite(resource.data)
                    && canWrite(request.resource.data)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.familyId == resource.data.familyId;
      allow delete: if canWrite(resource.data);
    }

    match /folders/{id} {
      allow read: if canRead(resource.data);
      allow create: if canWrite(request.resource.data)
                    && request.resource.data.userId == request.auth.uid;
      allow update: if canWrite(resource.data)
                    && canWrite(request.resource.data)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.familyId == resource.data.familyId;
      allow delete: if canWrite(resource.data);
    }
  }
}